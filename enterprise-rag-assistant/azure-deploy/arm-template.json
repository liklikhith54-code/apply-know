{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "appName": {
      "type": "string",
      "defaultValue": "enterprise-rag-assistant",
      "metadata": { "description": "Name of the Azure App Service web app" }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": { "description": "Azure region for all resources" }
    },
    "acrName": {
      "type": "string",
      "defaultValue": "enterpriseragacr",
      "metadata": { "description": "Azure Container Registry name" }
    },
    "appServicePlanSku": {
      "type": "string",
      "defaultValue": "B2",
      "allowedValues": ["B1", "B2", "B3", "S1", "S2", "P1v3", "P2v3"],
      "metadata": { "description": "App Service Plan SKU" }
    },
    "dockerImageTag": {
      "type": "string",
      "defaultValue": "latest",
      "metadata": { "description": "Docker image tag to deploy" }
    },
    "azureOpenAiEndpoint": { "type": "string", "defaultValue": "" },
    "azureOpenAiApiKey": { "type": "securestring", "defaultValue": "" },
    "azureOpenAiApiVersion": { "type": "string", "defaultValue": "2024-02-15-preview" },
    "azureOpenAiChatDeployment": { "type": "string", "defaultValue": "" },
    "azureOpenAiEmbeddingDeployment": { "type": "string", "defaultValue": "" },
    "azureOpenAiEmbeddingDimensions": { "type": "string", "defaultValue": "1536" },
    "azureSearchEndpoint": { "type": "string", "defaultValue": "" },
    "azureSearchApiKey": { "type": "securestring", "defaultValue": "" },
    "azureSearchIndexName": { "type": "string", "defaultValue": "enterprise-knowledge-index" },
    "azureStorageConnectionString": { "type": "securestring", "defaultValue": "" },
    "azureStorageContainer": { "type": "string", "defaultValue": "documents" },
    "appInsightsConnectionString": { "type": "securestring", "defaultValue": "" }
  },
  "variables": {
    "planName": "[concat('asp-', parameters('appName'))]",
    "acrLoginServer": "[concat(parameters('acrName'), '.azurecr.io')]",
    "dockerImage": "[concat(variables('acrLoginServer'), '/', parameters('appName'), ':', parameters('dockerImageTag'))]",
    "appInsightsName": "[concat('ai-', parameters('appName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('appInsightsName')]",
      "location": "[parameters('location')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "RetentionInDays": 90
      }
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2022-09-01",
      "name": "[variables('planName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('appServicePlanSku')]"
      },
      "kind": "linux",
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2022-09-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "[resourceId('Microsoft.Insights/components', variables('appInsightsName'))]"
      ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "siteConfig": {
          "linuxFxVersion": "[concat('DOCKER|', variables('dockerImage'))]",
          "alwaysOn": true,
          "healthCheckPath": "/health",
          "appSettings": [
            { "name": "WEBSITES_PORT", "value": "8000" },
            { "name": "MOCK_AZURE_SERVICES", "value": "false" },
            { "name": "AZURE_OPENAI_ENDPOINT", "value": "[parameters('azureOpenAiEndpoint')]" },
            { "name": "AZURE_OPENAI_API_KEY", "value": "[parameters('azureOpenAiApiKey')]" },
            { "name": "AZURE_OPENAI_API_VERSION", "value": "[parameters('azureOpenAiApiVersion')]" },
            { "name": "AZURE_OPENAI_CHAT_DEPLOYMENT", "value": "[parameters('azureOpenAiChatDeployment')]" },
            { "name": "AZURE_OPENAI_EMBEDDING_DEPLOYMENT", "value": "[parameters('azureOpenAiEmbeddingDeployment')]" },
            { "name": "AZURE_OPENAI_EMBEDDING_DIMENSIONS", "value": "[parameters('azureOpenAiEmbeddingDimensions')]" },
            { "name": "AZURE_SEARCH_ENDPOINT", "value": "[parameters('azureSearchEndpoint')]" },
            { "name": "AZURE_SEARCH_API_KEY", "value": "[parameters('azureSearchApiKey')]" },
            { "name": "AZURE_SEARCH_INDEX_NAME", "value": "[parameters('azureSearchIndexName')]" },
            { "name": "AZURE_STORAGE_CONNECTION_STRING", "value": "[parameters('azureStorageConnectionString')]" },
            { "name": "AZURE_STORAGE_CONTAINER", "value": "[parameters('azureStorageContainer')]" },
            { "name": "APPLICATIONINSIGHTS_CONNECTION_STRING", "value": "[parameters('appInsightsConnectionString')]" },
            { "name": "DOCKER_REGISTRY_SERVER_URL", "value": "[concat('https://', variables('acrLoginServer'))]" }
          ]
        },
        "httpsOnly": true
      }
    }
  ],
  "outputs": {
    "appUrl": {
      "type": "string",
      "value": "[concat('https://', parameters('appName'), '.azurewebsites.net')]"
    },
    "healthUrl": {
      "type": "string",
      "value": "[concat('https://', parameters('appName'), '.azurewebsites.net/health')]"
    },
    "apiDocsUrl": {
      "type": "string",
      "value": "[concat('https://', parameters('appName'), '.azurewebsites.net/docs')]"
    },
    "appInsightsName": {
      "type": "string",
      "value": "[variables('appInsightsName')]"
    }
  }
}
